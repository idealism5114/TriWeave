# Full data snapshots are uploaded as private GitHub Release assets.
# Keep market data, generated tensors, and data provenance out of Git history.
data/raw/*
data/standardized/*
data/derived/*
data/sealed/*
data/manifests/*
data/audit/*
!data/raw/.gitkeep
!data/standardized/.gitkeep
!data/derived/.gitkeep
!data/sealed/.gitkeep
!data/manifests/.gitkeep
!data/audit/.gitkeep
